   "source": [
    "def fibo(n):\n",
    "    if n<=1:\n",
    "        return n\n",
    "    else:\n",
    "        return fibo(n-1)+fibo(n-2)\n",
    "num=int(input(\"Enter the Number for what you want tof ind the fibonacci series : \"))\n",
    "for i in range(num):\n",
    "    print(fibo(i),end=' ')"
   ]
